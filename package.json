{
  "name": "switchyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Move Vercel projects to Cloudflare Workers",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "vite build --logLevel warn && node src/server/main.ts",
    "dev": "node --watch-path=./src src/server/main.ts",
    "build:web": "vite build",
    "dev:web": "vite build --watch",
    "test": "vitest run",
    "test:fixtures": "vitest run --config vitest.fixtures.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "magicast": "0.5.5",
    "open": "11.0.4",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "^18.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
